.PHONY : tests.s

# target to generate assembly for a file
tests.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/uberride_tests.dir/build.make CMakeFiles/uberride_tests.dir/tests.cpp.s
.PHONY : tests.cpp.s

